# Defaults for the single-ESP32 CSI streamer. `idf.py build` applies these on a fresh
# checkout; `idf.py menuconfig` overrides them into sdkconfig (which is gitignored).

# THE one flag you cannot forget. Without CSI compiled into the Wi-Fi library,
# esp_wifi_set_csi() fails and the board reboot-loops on startup. (IDF v5 renamed this to
# CONFIG_ESP_WIFI_CSI_ENABLED and migrates the old name automatically, so this one line
# works on both v4.3 and v5.x.)
CONFIG_ESP32_WIFI_CSI_ENABLED=y

# Serial throughput, not the radio, is the real cap on packet rate. One LLTF-only CSI line
# is ~500 bytes, so 115200 baud (11.5 kB/s) tops out near 20 Hz — and past that the board
# starts DROPPING queued CSI, which is worse than a lower rate because it makes the
# sampling uneven (measured on this rig: 24 Hz produced, 59 of 257 packets dropped).
# 921600 carries 100 Hz with room to spare.
#
# ESP_CONSOLE_UART_CUSTOM is required, not optional: in IDF the baud symbol only carries a
# prompt when CUSTOM is selected, and kconfiglib silently ignores values for symbols that
# have no prompt. Set the baud alone and it stays 115200 with no warning whatsoever - which
# then looks exactly like line corruption when you read at the rate you thought you set.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_GPIO=1
CONFIG_ESP_CONSOLE_UART_RX_GPIO=3
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# 1 ms tick: the self-ping interval and the printing task both want finer scheduling than
# the default 100 Hz tick can express.
CONFIG_FREERTOS_HZ=1000

# Receive-side buffers: CSI is generated per received frame, and starving the Wi-Fi driver
# of RX buffers shows up as an uneven packet rate (which reads as fake motion).
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP32_WIFI_RX_BA_WIN=16

# Keep the log quiet: every log line shares the UART with the CSI stream.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
